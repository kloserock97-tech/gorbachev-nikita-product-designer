{
  "name": "gorbachev-nikita-product-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && node tools/unused.mjs",
    "unused": "node tools/unused.mjs",
    "deadcode": "npx --yes knip --no-progress",
    "bundle": "node tools/bundle-report.mjs",
    "smoke": "node tools/cdp-touch.mjs --desktop --w 1440 --h 900 --dpr 1 --script tools/touch/smoke.json --url \"http://127.0.0.1:5191/?intro=0&lite=0\" --out shots/smoke --wait 9000",
    "audit:loader": "node tools/audit-nature-loader.mjs http://127.0.0.1:5191/"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "description": "Portfolio of Nikita Gorbachev: a real-time 3D hill with a scroll story, built with three.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
